generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String   @unique
  passwordHash String
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now())

  ownedTeams     Team[]       @relation("TeamCreator")
  teamMembers    TeamMember[]
  invitesSent    TeamInvite[] @relation("InviteSender")
  ownedTasks     Task[]       @relation("TaskOwner")
  assignedTasks  Task[]       @relation("TaskAssignee")
  createdTasks   Task[]       @relation("TaskCreator")
  comments       Comment[]
  auditLogs      TaskAuditLog[]
  createdProjects       Project[]            @relation("ProjectCreator")
  createdEpics          Epic[]               @relation("EpicCreator")
  epicAssignments       EpicAssignee[]
  projectVersions       ProjectVersion[]     @relation("ProjectVersionCreator")
  projectParticipations ProjectParticipant[]
  projectPtos           ProjectPto[]
  projectHolidays       ProjectHoliday[]
  createdHolidays       ProjectHoliday[]     @relation("HolidayCreator")
  createdPtos           ProjectPto[]         @relation("PtoCreator")
}

model Team {
  id        String   @id @default(uuid())
  name      String
  createdBy String
  createdAt DateTime @default(now())

  creator User         @relation("TeamCreator", fields: [createdBy], references: [id])
  members TeamMember[]
  invites TeamInvite[]
  tasks         Task[]
  projects      Project[]
  projectTeams  ProjectTeam[]
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model TeamInvite {
  id        String   @id @default(uuid())
  teamId    String
  email     String
  token     String   @unique
  status    String   @default("pending")
  invitedBy String
  createdAt DateTime @default(now())
  expiresAt DateTime

  team    Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter User @relation("InviteSender", fields: [invitedBy], references: [id])

  @@index([teamId, email])
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime
  priority    String   @default("medium")
  status      String   @default("todo")
  ownerId     String
  assigneeId  String
  teamId      String?
  createdBy   String
  alertAt     DateTime
  alertSent   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User           @relation("TaskOwner", fields: [ownerId], references: [id])
  assignee User           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator  User           @relation("TaskCreator", fields: [createdBy], references: [id])
  team     Team?          @relation(fields: [teamId], references: [id])
  comments Comment[]
  auditLogs TaskAuditLog[]
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model TaskAuditLog {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  action    String
  fieldName String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model Project {
  id        String   @id @default(uuid())
  name      String   @default("")
  startDate DateTime
  endDate   DateTime
  teamId    String?
  status    String   @default("draft")
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team            Team?                @relation(fields: [teamId], references: [id])
  creator         User                 @relation("ProjectCreator", fields: [createdBy], references: [id])
  sprints         Sprint[]
  epics           Epic[]
  versions        ProjectVersion[]
  projectTeams    ProjectTeam[]
  participants    ProjectParticipant[]
  holidays        ProjectHoliday[]
  ptos            ProjectPto[]
}

model ProjectHoliday {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  groupKey  String
  name      String   @default("Holiday")
  startDate DateTime
  endDate   DateTime
  createdBy String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator User    @relation("HolidayCreator", fields: [createdBy], references: [id])

  @@index([projectId])
  @@index([projectId, userId])
  @@index([projectId, groupKey])
}

model ProjectPto {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  name      String   @default("PTO")
  startDate DateTime
  endDate   DateTime
  createdBy String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator User    @relation("PtoCreator", fields: [createdBy], references: [id])

  @@index([projectId])
  @@index([projectId, userId])
}

model ProjectTeam {
  id        String   @id @default(uuid())
  projectId String
  teamId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([projectId, teamId])
}

model ProjectParticipant {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model ProjectVersion {
  id            String   @id @default(uuid())
  projectId     String
  versionNumber Int
  snapshot      String
  createdBy     String
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User    @relation("ProjectVersionCreator", fields: [createdBy], references: [id])

  @@unique([projectId, versionNumber])
  @@index([projectId])
}

model Sprint {
  id        String   @id @default(uuid())
  projectId String
  number    Int
  startDate DateTime
  endDate   DateTime

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Epic {
  id                String   @id @default(uuid())
  projectId         String
  sourceEpicId      String?
  groupKey          String?
  title             String
  workingDays       Int
  startSprintNumber Int?
  backgroundColor   String
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator    User           @relation("EpicCreator", fields: [createdBy], references: [id])
  sourceEpic Epic?          @relation("EpicCopies", fields: [sourceEpicId], references: [id], onDelete: Cascade)
  copies     Epic[]         @relation("EpicCopies")
  assignees  EpicAssignee[]

  @@index([sourceEpicId])
}

model EpicAssignee {
  id     String @id @default(uuid())
  epicId String
  userId String

  epic Epic @relation(fields: [epicId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([epicId, userId])
}
