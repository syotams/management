# Local Docker Compose (pre-production check). Copy to .env.local:
#   cp .env.local.example .env.local

MYSQL_ROOT_PASSWORD=local-root
MYSQL_DATABASE=management
MYSQL_USER=management
MYSQL_PASSWORD=local-db
MYSQL_HOST_PORT=3307

JWT_SECRET=local-dev-jwt-secret-not-for-production

DOMAIN=localhost
HTTP_PORT=8080
HTTPS_PORT=8443

# Must match the browser URL you use (HTTP on the mapped port).
APP_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080

# Leave BREVO_API_KEY empty to log emails instead of sending them.
BREVO_API_KEY=
EMAIL_FROM=noreply@localhost
EMAIL_FROM_NAME=
