# Copy to .env and fill in values before deploying:
#   cp .env.example .env

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=management
MYSQL_USER=management
MYSQL_PASSWORD=change-me-db

JWT_SECRET=change-me-to-a-long-random-string

# Public hostname (Let's Encrypt cert is issued for this name)
DOMAIN=sp.matheager.com
CERTBOT_EMAIL=you@example.com
# Set to 1 to test issuance against Let's Encrypt staging (untrusted cert, no prod rate limits)
CERTBOT_STAGING=0

# Public URL (used for invite links and CORS). Must match DOMAIN and use https.
APP_URL=https://sp.matheager.com
CORS_ORIGIN=https://sp.matheager.com
