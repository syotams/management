# Copy to .env and fill in values before deploying:
#   cp .env.example .env

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=management
MYSQL_USER=management
MYSQL_PASSWORD=change-me-db

JWT_SECRET=change-me-to-a-long-random-string

# Public URL of this droplet (used for invite links and CORS)
APP_URL=http://YOUR_DROPLET_IP
CORS_ORIGIN=http://YOUR_DROPLET_IP
