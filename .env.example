# Copy to .env and fill in values before deploying:
#   cp .env.example .env

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=management
MYSQL_USER=management
MYSQL_PASSWORD=change-me-db

JWT_SECRET=change-me-to-a-long-random-string

# Public hostname (Let's Encrypt cert is issued for this name)
DOMAIN=sp.matheager.com
CERTBOT_EMAIL=you@example.com
# Set to 1 to test issuance against Let's Encrypt staging (untrusted cert, no prod rate limits)
CERTBOT_STAGING=0

# Public URL (used for invite links, password reset, and CORS). Must match DOMAIN and use https.
APP_URL=https://sp.matheager.com
CORS_ORIGIN=https://sp.matheager.com

# Transactional email via Brevo's HTTPS API. DigitalOcean blocks outbound SMTP.
# Leave BREVO_API_KEY empty to log emails instead of sending them.
# The sender address must be verified in Brevo before mail will be accepted.
BREVO_API_KEY=
EMAIL_FROM=noreply.sp@matheager.com
EMAIL_FROM_NAME=
