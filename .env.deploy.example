# Settings for ./deploy/release.sh. Copy to .env.deploy (gitignored):
#   cp .env.deploy.example .env.deploy

# SSH target on the droplet. The user needs to be in the docker group.
DEPLOY_HOST=deploy@your-droplet-ip

# Deployment root on the droplet; everything (compose file, .env, backups, releases.log) lives here.
DEPLOY_DIR=/home/deploy/management

# Public hostname checked after deploy (https://$DOMAIN).
DOMAIN=sp.matheager.com

# Extra ssh options, e.g. a specific key or port.
# SSH_OPTS="-i ~/.ssh/id_ed25519 -p 22"

# Optional: an existing production account; if set, post-deploy checks also log in and read data.
# SANITY_EMAIL=
# SANITY_PASSWORD=

# Local port for the throwaway pre-deploy stack (uses this port and the next two).
# RELEASE_HTTP_PORT=18080
